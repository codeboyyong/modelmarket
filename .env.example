MM_APP_ENV=dev
DEV_MODE=true

# Database configuration.
# PostgreSQL is the implemented database for Phase 1.
# You can either set MM_DATABASE_URL directly, or use the MM_DB_* fields below.
MM_DATABASE_URL=
MM_DB_DRIVER=postgres
MM_DB_HOST=localhost
MM_DB_PORT=5432
MM_DB_NAME=model_market
MM_DB_USER=model_market
MM_DB_PASSWORD=model_market
MM_DB_SSL_MODE=disable
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
HTTP_ADDR=:8080
OBJECT_STORAGE_DIR=tmp/storage
OBJECT_STORAGE_PROVIDER=local
MM_ASSET_BUCKET=model-market-dev-assets
MM_ASSET_PUBLIC_URL=http://localhost:8080/api/v1/mock-s3
# Used only when OBJECT_STORAGE_PROVIDER=s3. Leave credentials empty while local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_MINUTES=15
PUBLIC_URL=http://localhost:3000

# OAuth credentials. Keep real secrets only in an ignored local .env or a
# production secret manager. Register the redirect URI exactly with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v23.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Provider/payment placeholders. Provider API key variables accept comma-separated
# pools and are selected round-robin, for example: key-one,key-two,key-three.
# Dev mode uses mocked providers and mocked payments.
OPENAI_API_KEY=
GEMINI_API_KEY=
PAYMENT_PROVIDER_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
