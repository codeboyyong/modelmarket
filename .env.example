MM_APP_ENV=dev
DEV_MODE=true

# Database configuration.
# PostgreSQL is the implemented database for Phase 1.
# You can either set MM_DATABASE_URL directly, or use the MM_DB_* fields below.
MM_DATABASE_URL=
MM_DB_DRIVER=postgres
MM_DB_HOST=localhost
MM_DB_PORT=5432
MM_DB_NAME=model_market
MM_DB_USER=model_market
MM_DB_PASSWORD=model_market
MM_DB_SSL_MODE=disable
REDIS_ADDR=localhost:6379
HTTP_ADDR=:8080
MOCK_DATA_DIR=mock-data
MIGRATIONS_DIR=backend/migrations
OBJECT_STORAGE_DIR=tmp/storage
PUBLIC_URL=http://localhost:3000

# OAuth placeholders for Phase 1. Real setup lands after provider credentials are available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Provider/payment placeholders. Dev mode uses mocked providers and mocked payments.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
